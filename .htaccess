DirectoryIndex index.php index.html

Options -Indexes

# Fix old hardcoded local paths
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^LYDO/lydo-system/(.*)$ /$1 [R=301,L]
    RewriteRule ^LYDO/(.*)$ /$1 [R=301,L]
</IfModule>

# Enable URL Rewriting for Production
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Get the base directory dynamically
    RewriteBase /

    # Redirect /youth/dashboard to /shared/youth/dashboard.php
    RewriteRule ^youth/dashboard/?$ shared/youth/dashboard.php [L]
    
    # Redirect /youth/* to /shared/youth/*
    RewriteRule ^youth/(.*)$ shared/youth/$1 [L]
    
    # Redirect /admin to /admin2/dashboard.php
    RewriteRule ^admin/?$ admin2/dashboard.php [L]
    
    # Redirect /org-president to /org-president/dashboard.php
    RewriteRule ^org-president/?$ org-president/dashboard.php [L]

    # Don't rewrite real files or directories (including index.html and index.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # For root path, don't rewrite - let DirectoryIndex handle it
    RewriteCond %{REQUEST_URI} !^/$
    
    # Only apply catch-all for non-existent paths
    RewriteRule ^(.*)$ index.html [L]
</IfModule>
